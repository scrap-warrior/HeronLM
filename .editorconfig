# Editor conventions, stated so an editor is not the thing that quietly changes a file. The reason this
# file exists at all is that two of these rules affect bytes: line endings, and the trailing newline an
# editor inserts on save.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Configuration and data are conventionally two-space, and a diff in them reads better without four.
[*.toml]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

# Markdown line breaks are meaningful: a hard break inside a paragraph is how the prose in ROADMAP keeps
# its intended wrapping, so trailing whitespace there is content rather than noise.
[*.md]
trim_trailing_whitespace = false

# The pinned tokenizer is excluded from every rule that can change bytes. Several pinned files here have
# no final newline, and inserting one changes the bytes the manifest digest was computed from, so an editor
# that "fixes" the file turns a checkout into a different vocabulary. `ignore` means the editor applies its
# own default instead of this file's, which is the point: the pin is only a pin if nothing edits it.
[tokenizer/**]
insert_final_newline = ignore
trim_trailing_whitespace = ignore
end_of_line = ignore
charset = utf-8
